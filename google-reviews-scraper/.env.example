# URL místa na Google Maps
# Příklad: https://www.google.com/maps/place/AAA+AUTO+Praha/@50.0755381,14.4378005,17z/data=...
GOOGLE_PLACE_URL=https://www.google.com/maps/place/AAA+AUTO/

# Volitelné: Datum od (YYYY-MM-DD)
# DATE_FROM=2024-01-01

# Volitelné: Datum do (YYYY-MM-DD)
# DATE_TO=2024-12-31

# Počet scrollů pro načtení recenzí (více scrollů = více recenzí)
# MAX_SCROLLS=30
